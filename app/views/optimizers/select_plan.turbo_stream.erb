<%= turbo_stream.replace "main_content" do %>
  <%= turbo_frame_tag "main_content" do %>
    <%= render "index", selected_plan: @selected_plan, sol3_phase: current_user.sol3_phase, results: @results, totals: @totals, farming_priority: @farming_priority, plans_any: @plans.any?, inventory_empty: @inventory_empty %>
  <% end %>
<% end %>

<%# The layout owns the one "modal" frame; empty it, never remove it. %>
<%= turbo_stream.update "modal", html: "" %>
