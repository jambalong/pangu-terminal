<%# locals: () %>

<% flash.each do |type, message| %>
  <% next if type == "api_token" %>

  <div class="flash-message <%= type %>" data-controller="flash"<%= raw(' role="alert"') if type == "alert" %>>
    <span class="flash-prefix">
      <%= type == 'alert' ? '[ERROR]' : '[SYSTEM]' %>
    </span>
    <%= message %>
  </div>
<% end %>