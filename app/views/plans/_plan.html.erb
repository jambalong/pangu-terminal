<%# locals: (plan:, materials_lookup:) %>

<div id="<%= dom_id(plan) %>" class="plan-card">
  <div class="plan-card-header">
    <div class="plan-card-subject">
      <%= render "shared/subject_portrait", subject: plan.subject %>

      <h3 class="plan-card-title">
        <%= plan.subject.name %>
      </h3>
    </div>

    <div class="plan-actions">
      <%= link_to "Edit",
          edit_plan_path(plan),
          data: { turbo_frame: "modal" },
          class: "edit-link" %>

      <%= link_to "Delete",
          confirm_delete_plan_path(plan),
          data: { turbo_frame: "modal" },
          class: "delete-link" %>
    </div>
  </div>

  <div class="plan-card-body">
    <% sorted_plan_materials(plan.plan_data.dig("output"), materials_lookup).each do |mat_id, qty| %>
      <% material = materials_lookup[mat_id.to_i] %>

      <div class="material-grid-item" data-tooltip="<%= material.name %>">
        <%= render "shared/material_icon", material: material %>

        <div class="mat-details">
          <span class="quantity-number"><%= format_quantity(qty) %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>
